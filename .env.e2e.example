# Credentials of the account the end-to-end suite signs in with.
#
# Copy this file to `.env.e2e` and fill in the real values. That copy is
# git-ignored and must stay out of the repository; in CI the same two variables
# come from the workflow's secrets instead.
#
# The account is an ordinary user of the Firebase project, created by hand in
# Authentication -> Users. It is not special in any way, which is the point:
# the suite exercises the same security rules as everybody else.
E2E_EMAIL=e2e@reading-shelf.test
E2E_PASSWORD=
