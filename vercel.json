{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/reading-shelf/browser",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "dist/reading-shelf/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "env": {
    "NG_ALLOWED_HOSTS": "*.vercel.app",
    "NG_TRUST_PROXY_HEADERS": "x-forwarded-host,x-forwarded-proto,x-forwarded-for,x-forwarded-port,x-forwarded-prefix"
  }
}
